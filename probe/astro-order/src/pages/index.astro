---
import { loadProducts } from '../lib/data.ts';
// Never actually runs during the probe build; the source is what matters here.
const products = import.meta.env.PROBE_FETCH ? await loadProducts() : [];
---
<html lang="en">
  <body>
    <ul>{products.map((p: any) => <li>{p.title}</li>)}</ul>
  </body>
</html>
