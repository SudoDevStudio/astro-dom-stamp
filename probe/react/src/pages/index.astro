---
import ProductList from '../components/ProductList.tsx';
import LiveFeed from '../components/LiveFeed.tsx';
import { loadProducts } from '../lib/data.ts';
const products = await loadProducts();
---
<html lang="en">
  <head><meta charset="utf-8" /><title>React probe</title></head>
  <body>
    <ul class="server">
      {products.map((p) => (
        <li class="server-card"><h3>{p.title}</h3><p>{p.blurb}</p></li>
      ))}
    </ul>
    <ProductList products={products} client:load />
    <LiveFeed client:only="react" />
  </body>
</html>
