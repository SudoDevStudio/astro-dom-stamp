---
import VueList from '../components/VueList.vue';
import VueFeed from '../components/VueFeed.vue';
import SvelteList from '../components/SvelteList.svelte';
import SvelteFeed from '../components/SvelteFeed.svelte';
import { loadProducts } from '../lib/data.ts';
const products = await loadProducts();
---
<html lang="en">
  <head><meta charset="utf-8" /><title>SFC probe</title></head>
  <body>
    <VueList products={products} client:load />
    <VueFeed client:only="vue" />
    <SvelteList products={products} client:load />
    <SvelteFeed client:only="svelte" />
  </body>
</html>
