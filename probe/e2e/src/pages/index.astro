---
import { loadProducts } from '../lib/data.ts';
const products = await loadProducts();
---
<html lang="en">
  <head><meta charset="utf-8" /><title>E2E probe</title></head>
  <body>
    <ul class="grid">
      {products.map((p) => (
        <li class="card"><h3>{p.title}</h3><p>{p.blurb}</p></li>
      ))}
    </ul>
  </body>
</html>
