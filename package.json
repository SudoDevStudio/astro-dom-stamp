{
  "name": "@sudodevstudio/astro-dom-stamp",
  "version": "0.1.0",
  "description": "Stamp data-* attributes onto DOM elements rendered from fetched data, for custom Astro visual editors. Zero cost in production.",
  "license": "MIT",
  "author": "SudoDevStudio",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SudoDevStudio/astro-dom-stamp.git"
  },
  "homepage": "https://github.com/SudoDevStudio/astro-dom-stamp#readme",
  "bugs": "https://github.com/SudoDevStudio/astro-dom-stamp/issues",
  "keywords": [
    "astro",
    "astro-integration",
    "visual-editing",
    "stega",
    "cms"
  ],
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": "./dist/index.js",
    "./runtime": "./dist/runtime/encode.js",
    "./browser": "./dist/browser/stamper.js",
    "./core": "./dist/core/index.js",
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "npm run build && node --experimental-strip-types bench/run.ts",
    "size": "npm run build && node --experimental-strip-types bench/size.ts"
  },
  "peerDependencies": {
    "astro": "^7.0.0"
  },
  "peerDependenciesMeta": {
    "astro": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "astro": "^7.3.3",
    "jsdom": "^30.1.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
