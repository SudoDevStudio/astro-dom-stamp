{
  "name": "@sudodevstudio/astro-dom-stamp",
  "version": "0.1.0",
  "description": "Stamp data-* attributes onto DOM elements rendered from fetched data.",
  "license": "MIT",
  "author": "Maninderpreet Singh",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SudoDevStudio/astro-dom-stamp.git"
  },
  "homepage": "https://github.com/SudoDevStudio/astro-dom-stamp#readme",
  "bugs": "https://github.com/SudoDevStudio/astro-dom-stamp/issues",
  "keywords": [
    "astro",
    "astro-integration",
    "visual-editing",
    "stega",
    "cms"
  ],
  "type": "module",
  "workspaces": [
    "examples/*"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": "./dist/index.js",
    "./runtime": "./dist/runtime/encode.js",
    "./browser": "./dist/browser/stamper.js",
    "./core": "./dist/core/index.js",
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "example": "npm run build && npm --workspace astro-dom-stamp-example-shop run dev:edit",
    "verify": "npm run build && node examples/shop/check.mjs && node examples/shop/check-dev.mjs"
  },
  "peerDependencies": {
    "astro": "^7.0.0"
  },
  "peerDependenciesMeta": {
    "astro": {
      "optional": true
    }
  },
  "devDependencies": {
    "@astrojs/node": "^11.1.6",
    "@astrojs/react": "^7.0.0",
    "@astrojs/svelte": "^9.0.1",
    "@astrojs/vue": "^7.0.3",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "astro": "^7.3.3",
    "jsdom": "^30.1.1",
    "playwright": "^1.63.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "svelte": "^5.57.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1",
    "vue": "^3.5.43"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "magic-string": "^1.4.1",
    "oxc-parser": "^0.151.0"
  }
}
